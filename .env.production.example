# ============================================================
# Sistem Informasi & Administrasi Sekolah — PRODUCTION ENV
# Salin ke .env di server (Coolify / Docker VPS).
# JANGAN commit file ini dengan nilai nyata.
# ============================================================

APP_NAME=Sistem Sekolah
APP_ENV=production
APP_KEY=base64:PASTIKAN_GANTI_DENGAN_KEY_BARU
APP_DEBUG=false
APP_URL=https://sistem-sekolah.domain.com

# Lokal
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sistem_sekolah
DB_USERNAME=sistem_sekolah
DB_PASSWORD=GANTI_PASSWORD_STRONG

# --- Redis (cache/queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@sistem-sekolah.domain.com
MAIL_FROM_NAME=Sistem Sekolah

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Storage ---
FILESYSTEM_DISK=local

# --- Sanctum / SPA stateful domains (pisahkan koma) ---
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
